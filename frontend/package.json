  "description": "BookingMx frontend with Jest tests",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "serve": "npx http-server -c-1 -p 5173 .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
